# Copy to .env with ./setup.sh, then fill in real values there. Never put secrets in this file.

# Local Postgres from docker compose
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auth_starter
APP_URL=http://localhost:3000

# Where the browser reaches the API. Same-origin by default.
# Point at an absolute origin (https://api.example.com/api/v1) after splitting the backend out.
NEXT_PUBLIC_API_URL=/api/v1

# Use independent random values of at least 32 characters: openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-access-token-secret
RATE_LIMIT_SECRET=change-me-to-a-long-random-rate-limit-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REQUIRE_EMAIL_VERIFICATION=false

# Cookie scope. Leave COOKIE_DOMAIN empty for same-origin; set both when the API is on another domain.
# Cross-domain requires COOKIE_SAME_SITE=none, which the server rejects unless the deployment is HTTPS.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Extra browser origins allowed to call the API with credentials (comma separated).
# APP_URL is always trusted. Fill this in only when the frontend is deployed separately.
ALLOWED_ORIGINS=

# Google OAuth callback: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Empty SMTP_HOST logs email links only outside production
MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
