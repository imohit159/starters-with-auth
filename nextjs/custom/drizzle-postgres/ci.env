# Throwaway values so `next build` can import the Zod env schema in CI.
# Not secrets, not used at runtime, never point at anything real.
# Presence of this file is what enables the build step in .github/workflows/starters.yml
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/build_only
APP_URL=https://localhost:3000
ACCESS_TOKEN_SECRET=ci-build-access-token-secret-not-a-real-secret
RATE_LIMIT_SECRET=ci-build-rate-limit-secret-not-a-real-secret
