# Copy to .env with ./setup.sh, then fill in real values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auth_starter
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
REQUIRE_EMAIL_VERIFICATION=false

# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Empty SMTP_HOST logs verification/reset links in development.
MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
