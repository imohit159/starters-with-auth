# Single workspace env. `./setup.sh` copies this to `.env` and symlinks it
# into apps/* and packages/*. Do not commit `.env`.

# --- Host (apps/api) ---

# development | test | production
NODE_ENV=development
# Express listen port
PORT=4000
# Local Postgres. docker compose publishes 5432
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auth_starter
# Public API origin (CORS / docs). Must match PORT
API_ORIGIN=http://localhost:4000
# Next.js origin. CORS allowlist + Google OAuth browser redirect after callback
WEB_ORIGIN=http://localhost:3000

# --- Auth cookies + JWT (packages/services) ---

# HS256 secret. Min 32 characters. Rotate in production
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-access-token-secret
# jsonwebtoken expiresIn string, e.g. 15m, 1h
ACCESS_TOKEN_EXPIRES_IN=15m
# Hashed refresh session TTL in Postgres
REFRESH_TOKEN_EXPIRES_DAYS=7
# lax for localhost. none (and HTTPS) if API and web are different sites
COOKIE_SAMESITE=lax
# true = register does not set cookies until the email verify link is used
REQUIRE_EMAIL_VERIFICATION=false

# --- Google OAuth ---
# Authorized redirect in Google Cloud Console must match GOOGLE_REDIRECT_URI exactly

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# --- Mail ---
# Leave SMTP_HOST empty to log verify/reset emails to the API console

MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Web (apps/web) ---
# Next.js inlines NEXT_PUBLIC_* at build time. No /api/v1 suffix — tRPC is at /trpc

NEXT_PUBLIC_API_URL=http://localhost:4000
