# API host env. Prefer the workspace root `.env` via `./setup.sh`.
# This file is the fallback if you copy it to apps/api/.env instead.

# development | test | production
NODE_ENV=development
# Express listen port
PORT=4000
# Local Mongo. docker compose publishes 27017
MONGODB_URI=mongodb://127.0.0.1:27017/auth_starter
# Public API origin (CORS / docs). Must match PORT
API_ORIGIN=http://localhost:4000
# Next.js origin. CORS allowlist + Google OAuth browser redirect after callback
WEB_ORIGIN=http://localhost:3000

# HS256 secret. Min 32 characters. Rotate in production
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-access-token-secret
# jsonwebtoken expiresIn string, e.g. 15m, 1h
ACCESS_TOKEN_EXPIRES_IN=15m
# Hashed refresh session TTL in Mongo
REFRESH_TOKEN_EXPIRES_DAYS=7
# lax for localhost. none (and HTTPS) if API and web are different sites
COOKIE_SAMESITE=lax
# true = register does not set cookies until the email verify link is used
REQUIRE_EMAIL_VERIFICATION=false

# Authorized redirect in Google Cloud Console must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Leave SMTP_HOST empty to log verify/reset emails to the API console
MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe test mode. Empty keys disable checkout until you fill them in.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/billing?status=canceled
